# Copy to `.env` and fill in. `.env` is git-ignored — never commit real values.
#
# Local development runs against the backend's `local` profile, which uses mock AI
# clients and filesystem audio storage. In that setup the Anthropic and OpenAI keys
# below are not required; the auth and internal-auth values still are.

# --- Backend boundary -------------------------------------------------------
# Origin of the Spring Boot service. `local` profile serves on 8080.
PHRASELOG_BACKEND_BASE_URL=http://localhost:8080
# Shared secret signing the BFF -> Spring internal-auth header (ADR-010).
# Any non-empty string works locally; production reads it from AWS Secrets Manager.
INTERNAL_AUTH_SECRET=

# --- NextAuth ---------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_KAKAO_ID=
AUTH_KAKAO_SECRET=
# Print the email magic link to the server console instead of sending it over SES.
# Local development only.
AUTH_EMAIL_DEV_CONSOLE=true

# --- AI providers -----------------------------------------------------------
# Only needed when running against real models rather than the local mock clients.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
