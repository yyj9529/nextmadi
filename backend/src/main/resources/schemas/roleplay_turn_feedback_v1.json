{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Roleplay Turn Feedback v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["show_feedback"],
      "properties": {
        "show_feedback": {
          "const": false
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["show_feedback", "natural_alternative", "korean_comment"],
      "properties": {
        "show_feedback": {
          "const": true
        },
        "natural_alternative": {
          "type": "string",
          "minLength": 1
        },
        "korean_comment": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  ]
}
