.env
.env.*
!.env.example

node_modules/
.next/
*.tsbuildinfo
dist/
build/

.gradle/
target/
out/

.DS_Store

# Local eval runs are ignored by default. Promote reviewed baselines with
# `git add -f eval/runs/<artifact>.json` after confirming they contain no raw user text.
eval/runs/*.json
!eval/runs/.gitkeep

*.log

# Python bytecode cache from the eval runner and its tests.
__pycache__/

# Local Claude/Codex permission allowlists are machine-specific.
**/.claude/settings.local.json

# Local-only Spring profile: holds local DB credentials + dev toggles (e.g. the
# mock Anthropic client). Never commit — see the file header.
**/application-local.yml

# Local-only Postman collection: holds the dev X-Internal-Auth signing secret +
# token-minting script for hitting the backend directly. Never commit — see the
# collection description.
**/*.postman_collection.json

# IDE / build artifacts
**/.idea/
**/.vscode/
backend/bin/

# Generated docs index (`bun run docs:index`). Rebuildable from docs/**, so the
# HTML output stays out of the repo.
docs/_site/

.playwright-mcp/
docs/.playwright-mcp/

# Ad-hoc screenshots dropped at the repo root during UI verification. Browser
# evidence belongs on the issue/PR, not in the tree.
/*.png
